# ── App ──────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://invest_user:password@localhost:5432/invest_dashboard

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Anthropic (Claude) ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-replace_me

# ── Robinhood ────────────────────────────────────────────
ROBINHOOD_USERNAME=your@email.com
ROBINHOOD_PASSWORD=your_robinhood_password
# Base32 TOTP secret from scanning Robinhood's MFA QR code
# Get it with: python -c "import pyotp; uri=input('paste URI: '); print(pyotp.parse_uri(uri).secret)"
ROBINHOOD_MFA_SECRET=BASE32TOTPSECRETHERE

# ── NewsAPI.org (free tier: 100 req/day) ─────────────────
NEWSAPI_KEY=your_newsapi_key

# ── Reddit (PRAW) — create app at reddit.com/prefs/apps ──
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=invest-dashboard/1.0 by u/yourname

# ── Job Schedules ────────────────────────────────────────
JOB_SCRAPE_NEWS_INTERVAL_MINUTES=30
JOB_RUN_ANALYSIS_INTERVAL_HOURS=4
JOB_SYNC_PORTFOLIO_INTERVAL_MINUTES=15
JOB_CHECK_ALERTS_INTERVAL_MINUTES=5

# ── Analysis Settings ────────────────────────────────────
ANALYSIS_NEWS_LOOKBACK_HOURS=6
ANALYSIS_MAX_ARTICLES=80
