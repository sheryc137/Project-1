# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── MongoDB ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/waves_delivery

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Nodemailer (Gmail example) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=waves.delivery@gmail.com
SMTP_PASS=your_app_password_here
FROM_EMAIL="Waves Delivery <waves.delivery@gmail.com>"

# ── Client (.env in client/) ─────────────────────────────
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000
# VITE_STRIPE_PUBLIC_KEY=pk_test_replace_me
